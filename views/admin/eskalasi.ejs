<%- include('../partials/head', { title: title }) %>
<%- include('../partials/nav') %>
<main class="container py-4" style="max-width:820px">
  <a href="/admin?tab=eskalasi" class="small text-decoration-none">← Kembali ke daftar eskalasi</a>
  <div class="card-soft p-4 mt-2 mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h1 class="h5 fw-bold mb-1">Eskalasi #<%= e.id %></h1>
        <div class="small text-muted"><%= e.nama_pelanggan %> (<%= e.email %>) · <%= formatTimestamp(new Date(e.dibuat)) %></div>
      </div>
      <span class="badge rounded-pill text-bg-<%= e.status === 'Selesai' ? 'success' : 'warning' %> px-3 py-2"><%= e.status %></span>
    </div>
  </div>

  <% if (pesan) { %><div class="alert alert-<%= tipe %> py-2"><%= pesan %></div><% } %>

  <div class="card-soft p-4 mb-3">
    <h2 class="h6 fw-bold mb-3">Riwayat Chat</h2>
    <% riwayat.forEach(function (m) { %>
      <div class="mb-2 d-flex <%= m.pengirim === 'user' ? 'justify-content-end' : '' %>">
        <div class="p-2 px-3 rounded-4 small" style="max-width:85%; <%= m.pengirim === 'user' ? 'background:#4f46e5;color:#fff' : (m.pengirim === 'staf' ? 'background:#dcfce7' : 'background:#f1f5f9') %>">
          <div class="fw-semibold" style="font-size:.7rem; opacity:.8"><%= m.pengirim === 'user' ? 'Pelanggan' : (m.pengirim === 'staf' ? 'Staf' : 'Chatbot') %> · <%= formatTimestamp(new Date(m.dibuat)) %></div>
          <div style="white-space:pre-wrap"><%= m.isi %></div>
        </div>
      </div>
    <% }) %>
    <% if (!riwayat.length) { %><p class="text-muted small mb-0">Tidak ada riwayat.</p><% } %>
  </div>

  <div class="card-soft p-4">
    <h2 class="h6 fw-bold mb-3">Balasan Staf</h2>
    <% if (e.status === 'Selesai') { %>
      <div class="p-3 rounded-3" style="background:#f0fdf4"><%= e.balasan_staf %></div>
    <% } else { %>
      <form method="POST" action="/admin/eskalasi/<%= e.id %>">
        <textarea name="balasan" rows="3" class="form-control mb-3" placeholder="Tulis balasan untuk pelanggan..." required></textarea>
        <button class="btn btn-brand px-4" type="submit">Kirim &amp; Tandai Selesai</button>
      </form>
    <% } %>
  </div>
</main>
</body>
</html>
