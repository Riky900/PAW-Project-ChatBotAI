<%- include('../partials/head', { title: title }) %>
<%- include('../partials/nav') %>
<main class="container py-4">
  <div class="hero-mini mb-4">
    <h1 class="h4 fw-bold mb-1">Halo, <%= user.nama %> 👋</h1>
    <p class="mb-0" style="color:#e0e7ff">Pantau pesananmu di sini. Tanyakan statusnya juga lewat chatbot dengan mengirim nomor pesanan (contoh: ORD-1001).</p>
  </div>

  <% if (pesan) { %><div class="alert alert-<%= tipe %> py-2"><%= pesan %></div><% } %>

  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card-soft p-4">
        <h2 class="h6 fw-bold mb-3">🛒 Buat Pesanan</h2>
        <form method="POST" action="/pesanan">
          <div class="mb-2">
            <label class="form-label small fw-semibold mb-1">Produk</label>
            <select name="produk_id" class="form-select form-select-sm" required>
              <% produk.forEach(function (p) { %>
                <option value="<%= p.id %>" <%= p.stok < 1 ? 'disabled' : '' %>><%= p.nama %> — <%= formatRupiah(p.harga) %> (stok <%= p.stok %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold mb-1">Jumlah</label>
            <input type="number" name="jumlah" class="form-control form-control-sm" min="1" value="1" required>
          </div>
          <button class="btn btn-brand w-100" type="submit">Pesan Sekarang</button>
        </form>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card-soft p-4 mb-4">
        <h2 class="h6 fw-bold mb-3">📦 Riwayat Pesanan</h2>
        <div class="table-responsive">
          <table class="table table-hover align-middle small mb-0">
            <thead class="table-light"><tr><th>No. Pesanan</th><th>Produk</th><th>Total</th><th>Status</th><th>Estimasi Tiba</th></tr></thead>
            <tbody>
              <% if (!pesanan.length) { %>
                <tr><td colspan="5" class="text-center text-muted py-3">Belum ada pesanan.</td></tr>
              <% } %>
              <% pesanan.forEach(function (p) { %>
                <tr>
                  <td class="fw-semibold"><%= p.nomor_pesanan %></td>
                  <td><%= p.nama_produk %> ×<%= p.jumlah %></td>
                  <td><%= formatRupiah(p.total) %></td>
                  <td><span class="badge rounded-pill text-bg-<%= p.status === 'Selesai' ? 'success' : (p.status === 'Dibatalkan' ? 'danger' : (p.status === 'Dikirim' ? 'info' : 'warning')) %>"><%= p.status %></span></td>
                  <td><%= p.estimasi_tiba ? new Date(p.estimasi_tiba).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card-soft p-4">
        <h2 class="h6 fw-bold mb-3">👩‍💼 Bantuan dari Staf</h2>
        <% if (!eskalasi.length) { %>
          <p class="text-muted small mb-0">Belum ada permintaan bantuan. Tekan "Hubungi staf" di widget chat jika chatbot tidak bisa membantu.</p>
        <% } %>
        <% eskalasi.forEach(function (e) { %>
          <div class="border rounded-3 p-3 mb-2 small">
            <div class="d-flex justify-content-between">
              <b>Permintaan #<%= e.id %></b>
              <span class="badge rounded-pill text-bg-<%= e.status === 'Selesai' ? 'success' : 'warning' %>"><%= e.status %></span>
            </div>
            <div class="text-muted"><%= formatTimestamp(new Date(e.dibuat)) %></div>
            <% if (e.balasan_staf) { %><div class="mt-2 p-2 rounded-3" style="background:#eef2ff"><b>Balasan staf:</b> <%= e.balasan_staf %></div><% } else { %><div class="mt-2 text-muted">Menunggu ditangani staf…</div><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</main>
</body>
</html>
