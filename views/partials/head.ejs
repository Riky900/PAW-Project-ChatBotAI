<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root { --brand: #4f46e5; --brand-dark: #3730a3; --ink: #0f172a; --muted: #64748b; }
    body { font-family: 'Poppins', sans-serif; background: #f8fafc; color: var(--ink); }
    .nav-glass { background: rgba(255,255,255,.85); backdrop-filter: blur(10px); border-bottom: 1px solid #e2e8f0; }
    .brand { font-weight: 700; letter-spacing: -.3px; color: var(--ink); text-decoration: none; }
    .brand span { color: var(--brand); }
    .btn-brand { background: var(--brand); border: 0; color: #fff; border-radius: 999px; font-weight: 600; }
    .btn-brand:hover { background: var(--brand-dark); color: #fff; }
    .card-soft { border: 0; border-radius: 20px; background: #fff; box-shadow: 0 2px 12px rgba(15,23,42,.06); }
    .hero-mini { background: linear-gradient(135deg, #312e81 0%, #4f46e5 55%, #7c3aed 100%); color: #fff; border-radius: 24px; padding: 28px 32px; }
    .nav-pills .nav-link { color: var(--muted); font-weight: 500; border-radius: 999px; }
    .nav-pills .nav-link.active { background: var(--brand); color: #fff; }
    .form-control:focus, .form-select:focus { border-color: var(--brand); box-shadow: 0 0 0 .2rem rgba(79,70,229,.15); }
  </style>
</head>
<body>
