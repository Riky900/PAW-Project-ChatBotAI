<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root { --brand: #4f46e5; --brand-dark: #3730a3; --ink: #0f172a; --muted: #64748b; }
    body { font-family: 'Poppins', sans-serif; background: #f8fafc; color: var(--ink); }

    /* Navbar */
    .nav-glass { background: rgba(255,255,255,.85); backdrop-filter: blur(10px); border-bottom: 1px solid #e2e8f0; }
    .brand { font-weight: 700; letter-spacing: -.3px; color: var(--ink); }
    .brand span { color: var(--brand); }
    .btn-admin-nav { border: 1.5px solid #cbd5e1; background: #fff; color: var(--ink); border-radius: 999px; font-size: .82rem; font-weight: 600; padding: 6px 16px; transition: all .2s; }
    .btn-admin-nav:hover { border-color: var(--brand); color: var(--brand); background: #eef2ff; }

    /* Hero */
    .hero { background: linear-gradient(135deg, #312e81 0%, #4f46e5 55%, #7c3aed 100%);
            color: #fff; border-radius: 28px; padding: 56px 48px; position: relative; overflow: hidden; }
    .hero::after { content: ''; position: absolute; right: -80px; top: -80px; width: 320px; height: 320px;
                   border-radius: 50%; background: rgba(255,255,255,.08); }
    .hero::before { content: ''; position: absolute; right: 120px; bottom: -120px; width: 240px; height: 240px;
                    border-radius: 50%; background: rgba(255,255,255,.06); }
    .hero h1 { font-weight: 700; font-size: clamp(1.7rem, 3.5vw, 2.6rem); letter-spacing: -.5px; }
    .hero p { color: #e0e7ff; max-width: 560px; }
    .btn-hero { background: #fff; color: var(--brand-dark); font-weight: 600; border-radius: 999px; padding: 10px 26px; border: 0; }
    .btn-hero:hover { background: #eef2ff; color: var(--brand-dark); }
    .stat { background: rgba(255,255,255,.12); border-radius: 16px; padding: 14px 20px; }
    .stat b { font-size: 1.4rem; display: block; }
    .stat small { color: #c7d2fe; }

    /* Filter */
    .pill { border: 1px solid #e2e8f0; background: #fff; color: var(--muted); border-radius: 999px;
            padding: 6px 18px; font-size: .88rem; font-weight: 500; transition: all .2s; }
    .pill:hover { border-color: var(--brand); color: var(--brand); }
    .pill.active { background: var(--brand); border-color: var(--brand); color: #fff; }

    /* Kartu produk */
    .produk-card { border: 0; border-radius: 20px; overflow: hidden; background: #fff; cursor: pointer;
                   box-shadow: 0 2px 12px rgba(15,23,42,.06); transition: transform .25s, box-shadow .25s; }
    .produk-card:hover { transform: translateY(-6px); box-shadow: 0 16px 36px rgba(79,70,229,.18); }
    .produk-img { aspect-ratio: 4 / 3; overflow: hidden; background: #eef2ff; position: relative; }
    .produk-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .produk-card:hover .produk-img img { transform: scale(1.06); }
    .kategori { position: absolute; left: 14px; top: 14px; background: rgba(255,255,255,.92);
                color: var(--brand-dark); font-size: .75rem; font-weight: 600; padding: 4px 12px; border-radius: 999px; }
    .harga { font-size: 1.2rem; font-weight: 700; color: var(--brand); }
    .stok-ok { color: #059669; font-size: .82rem; font-weight: 500; }
    .stok-tipis { color: #d97706; font-size: .82rem; font-weight: 500; }
    .btn-tanya { border: 1.5px solid var(--brand); color: var(--brand); border-radius: 12px; font-weight: 500; font-size: .88rem; }
    .btn-tanya:hover { background: var(--brand); color: #fff; }

    /* Modal Detail Produk */
    .modal-produk-content { border: 0; border-radius: 24px; overflow: hidden; box-shadow: 0 20px 50px rgba(15,23,42,.25); }
    .modal-produk-img { background: #eef2ff; height: 220px; display: flex; align-items: center; justify-content: center; padding: 20px; position: relative; }
    .modal-produk-img img { max-height: 100%; max-width: 100%; object-fit: contain; }
    .modal-deskripsi { color: #475569; font-size: .92rem; line-height: 1.65; }

    footer { color: var(--muted); font-size: .85rem; }

    /* Chat widget */
    #chat-toggle { position: fixed; right: 24px; bottom: 24px; z-index: 1050; width: 62px; height: 62px;
                   border-radius: 50%; border: 0; background: var(--brand); color: #fff; font-size: 1.6rem;
                   box-shadow: 0 10px 28px rgba(79,70,229,.45); transition: transform .2s; }
    #chat-toggle:hover { transform: scale(1.08); }
    #chat-box { position: fixed; right: 24px; bottom: 100px; width: 360px; max-width: calc(100vw - 48px);
                z-index: 1050; display: none; border: 0; border-radius: 22px; overflow: hidden; transform-origin: bottom right; animation: chatIn .28s ease;
                box-shadow: 0 20px 50px rgba(15,23,42,.25); background: #fff; }
    .chat-head { background: linear-gradient(135deg, #4f46e5, #7c3aed); color: #fff; padding: 16px 18px; display: flex; align-items: center; gap: 12px; }
    .avatar { width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,.2); display: grid; place-items: center; font-size: 1.2rem; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; display: inline-block; margin-right: 5px; }
    #chat-messages { height: 320px; overflow-y: auto; padding: 16px; background: #f8fafc; }
    .bubble { max-width: 85%; padding: 9px 14px; border-radius: 16px; margin-bottom: 10px; font-size: .88rem; line-height: 1.45; width: fit-content; animation: pop .25s ease; }
    .bubble.bot { background: #fff; border: 1px solid #e2e8f0; border-bottom-left-radius: 4px; }
    .bubble.user { background: var(--brand); color: #fff; margin-left: auto; border-bottom-right-radius: 4px; }
    .chat-foot { padding: 12px; border-top: 1px solid #e2e8f0; display: flex; gap: 8px; background: #fff; box-sizing: border-box; width: 100%; }
    .chat-foot input { border-radius: 999px; border: 1px solid #e2e8f0; padding: 8px 16px; flex: 1 1 auto; min-width: 0; width: 100%; font-size: .9rem; outline: none; }
    .chat-foot input:focus { border-color: var(--brand); }
    .chat-foot button { border: 0; background: var(--brand); color: #fff; border-radius: 999px; padding: 8px 18px; font-weight: 500; flex: 0 0 auto; white-space: nowrap; }

    /* ===== Animasi ===== */
    @keyframes pop    { from { opacity: 0; transform: translateY(8px) scale(.96); } to { opacity: 1; transform: none; } }
    @keyframes chatIn  { from { opacity: 0; transform: translateY(16px) scale(.92); } to { opacity: 1; transform: none; } }
    @keyframes fadeUp  { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
    @keyframes floaty  { 0%,100% { transform: translateY(0); } 50% { transform: translateY(22px); } }
    @keyframes bounce  { 0%,60%,100% { transform: translateY(0); opacity: .45; } 30% { transform: translateY(-5px); opacity: 1; } }
    @keyframes blink   { 50% { opacity: 0; } }
    @keyframes ring    { 0% { transform: scale(1); opacity: .6; } 100% { transform: scale(1.6); opacity: 0; } }

    .hero::after  { animation: floaty 7s ease-in-out infinite; }
    .hero::before { animation: floaty 9s ease-in-out infinite reverse; }

    #hero-title .off { visibility: hidden; }
    #hero-title.caret .on::after { content: '|'; margin-left: 2px; font-weight: 300; animation: blink 1s steps(1) infinite; }

    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .6s ease, transform .6s ease; }
    .reveal.show { opacity: 1; transform: none; }
    .refade { animation: fadeUp .45s ease both; }

    #chat-toggle::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--brand);
                          animation: ring 2s ease-out infinite; pointer-events: none; }

    .bubble.typing { display: flex; gap: 5px; padding: 12px 16px; }
    .bubble.typing span { width: 7px; height: 7px; border-radius: 50%; background: #94a3b8; animation: bounce 1.2s infinite; }
    .bubble.typing span:nth-child(2) { animation-delay: .15s; }
    .bubble.typing span:nth-child(3) { animation-delay: .3s; }

    .chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 12px 0; background: #fff; border-top: 1px solid #e2e8f0; }
    .chip { border: 1px solid #c7d2fe; background: #eef2ff; color: var(--brand-dark); border-radius: 999px;
            padding: 4px 12px; font-size: .78rem; font-weight: 500; transition: all .2s; }
    .chip:hover { background: var(--brand); color: #fff; border-color: var(--brand); transform: translateY(-1px); }
    .chips + .chat-foot { border-top: 0; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
      .reveal { opacity: 1; transform: none; }
      #hero-title .off { visibility: visible; }
    }

    @media (max-width: 576px) { .hero { padding: 36px 24px; } }
  </style>
</head>
<body>

  <nav class="nav-glass sticky-top py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="brand text-decoration-none fs-5" href="/">ChatBot <span>AI</span> Store</a>
      <div class="d-flex align-items-center gap-2">
        <span id="status-badge" class="badge rounded-pill text-bg-secondary fw-normal px-3 py-2 d-none d-sm-inline-block">Mengecek server...</span>
        <button id="btn-open-admin" class="btn btn-admin-nav">🔐 Admin</button>
      </div>
    </div>
  </nav>

  <main class="container py-4">

    <section class="hero mb-5">
      <div class="position-relative" style="z-index:1">
        <h1 class="mb-3" id="hero-title">Halo, ada yang bisa saya bantu hari ini?</h1>
        <p class="mb-4"><%= tagline %></p>
        <button class="btn btn-hero" id="hero-chat">Mulai Chat Sekarang</button>
        <div class="d-flex flex-wrap gap-3 mt-5">
          <div class="stat"><b>24 jam</b><small>Layanan chatbot</small></div>
          <div class="stat"><b>&lt; 30 detik</b><small>Waktu respons</small></div>
          <div class="stat"><b><span class="count" data-to="<%= produk.length %>"><%= produk.length %></span> produk</b><small>Siap dipesan</small></div>
        </div>
      </div>
    </section>

    <% var kategoriList = [...new Set(produk.map(function (p) { return p.kategori; }))]; %>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <h2 class="h4 fw-bold mb-0">Produk Pilihan</h2>
        <small class="text-muted">Klik kartu produk untuk melihat detail &amp; deskripsi</small>
      </div>
      <div class="d-flex flex-wrap gap-2" id="filter">
        <button class="pill active" data-kategori="semua">Semua</button>
        <% kategoriList.forEach(function (k) { %>
          <button class="pill" data-kategori="<%= k %>"><%= k %></button>
        <% }) %>
      </div>
    </div>

    <div class="row g-4" id="grid">
      <% produk.forEach(function (p, i) { %>
        <div class="col-12 col-sm-6 col-lg-4 item reveal" data-kategori="<%= p.kategori %>">
          <div class="produk-card h-100 d-flex flex-column"
               data-gambar="<%= p.gambar %>"
               data-kategori="<%= p.kategori %>"
               data-nama="<%= p.nama %>"
               data-harga="<%= formatRupiah(p.harga) %>"
               data-stok="<%= p.stok %>"
               data-deskripsi="<%= p.deskripsi || 'Belum ada deskripsi untuk produk ini.' %>">
            <div class="produk-img">
              <img src="<%= p.gambar %>" alt="<%= p.nama %>" loading="lazy">
              <span class="kategori"><%= p.kategori %></span>
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
              <h3 class="h6 fw-semibold mb-1"><%= p.nama %></h3>
              <div class="harga mb-1"><%= formatRupiah(p.harga) %></div>
              <% if (p.stok <= 15) { %>
                <div class="stok-tipis mb-3">● Stok terbatas: <%= p.stok %> unit</div>
              <% } else { %>
                <div class="stok-ok mb-3">● Tersedia: <%= p.stok %> unit</div>
              <% } %>
              <button class="btn btn-tanya mt-auto tanya" data-nama="<%= p.nama %>">💬 Tanya chatbot</button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <footer class="text-center mt-5 pt-4 border-top">
      <p class="mb-1">Endpoint API:
        <a href="/api/status" target="_blank">/api/status</a> ·
        <a href="/api/produk" target="_blank">/api/produk</a>
      </p>
      <p>PPAW Week · Express.js + EJS + Bootstrap</p>
    </footer>
  </main>

  <!-- Modal Detail Produk -->
  <div class="modal fade" id="modalDetailProduk" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-produk-content">
        <div class="modal-produk-img">
          <span class="kategori" id="modal-kategori"></span>
          <button type="button" class="btn-close position-absolute top-0 end-0 m-3 bg-white p-2 rounded-circle shadow-sm" data-bs-dismiss="modal" aria-label="Tutup"></button>
          <img id="modal-gambar" src="" alt="Detail Produk">
        </div>
        <div class="modal-body p-4">
          <h4 class="fw-bold mb-1" id="modal-nama"></h4>
          <div class="harga mb-2" id="modal-harga"></div>
          <div class="mb-3" id="modal-stok"></div>
          <hr class="my-3">
          <h6 class="fw-semibold mb-2">Deskripsi Produk</h6>
          <p class="modal-deskripsi mb-4" id="modal-deskripsi"></p>
          <button type="button" class="btn btn-tanya w-100 py-2" id="modal-btn-tanya">💬 Tanya chatbot soal produk ini</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Login Admin -->
  <div class="modal fade" id="modalAdminLogin" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content rounded-4 border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">🔐 Login Admin</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="form-admin-login">
            <label class="form-label small text-muted">Masukkan Password Admin</label>
            <input type="password" id="input-admin-pass" class="form-control mb-2" placeholder="Password..." required>
            <div id="login-error" class="text-danger small mb-2" style="display:none;"></div>
            <button type="submit" class="btn btn-primary w-100 rounded-pill" style="background: var(--brand); border:0;">Masuk</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Panel Admin (CRUD Produk) -->
  <div class="modal fade" id="modalAdminPanel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content rounded-4 border-0 shadow">
        <div class="modal-header" style="background: linear-gradient(135deg, #312e81, #4f46e5); color: #fff;">
          <h5 class="modal-title fw-bold">⚙️ Panel Admin - Kelola Katalog Produk</h5>
          <div class="d-flex align-items-center gap-2">
            <button type="button" id="btn-admin-logout" class="btn btn-sm btn-outline-light rounded-pill px-3">Logout</button>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
        </div>
        <div class="modal-body p-4">
          <div class="row g-4">
            <!-- Form Tambah / Edit Produk -->
            <div class="col-lg-4">
              <div class="card border-0 bg-light rounded-4 p-3">
                <h6 class="fw-bold mb-3" id="form-produk-title">➕ Tambah Produk Baru</h6>
                <form id="form-admin-produk">
                  <input type="hidden" id="prod-id">
                  <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Nama Produk</label>
                    <input type="text" id="prod-nama" class="form-control form-control-sm" placeholder="Contoh: Mouse Gaming" required>
                  </div>
                  <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Kategori</label>
                    <input type="text" id="prod-kategori" class="form-control form-control-sm" placeholder="Komputer / Audio / Aksesoris" required>
                  </div>
                  <div class="row g-2 mb-2">
                    <div class="col-7">
                      <label class="form-label small fw-semibold mb-1">Harga (Rp)</label>
                      <input type="number" id="prod-harga" class="form-control form-control-sm" placeholder="250000" required>
                    </div>
                    <div class="col-5">
                      <label class="form-label small fw-semibold mb-1">Stok</label>
                      <input type="number" id="prod-stok" class="form-control form-control-sm" placeholder="10" required>
                    </div>
                  </div>
                  <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Path / URL Gambar</label>
                    <select id="prod-gambar" class="form-select form-select-sm">
                      <option value="/images/headset.svg">/images/headset.svg</option>
                      <option value="/images/keyboard.svg">/images/keyboard.svg</option>
                      <option value="/images/mouse.svg">/images/mouse.svg</option>
                      <option value="/images/powerbank.svg">/images/powerbank.svg</option>
                      <option value="/images/webcam.svg">/images/webcam.svg</option>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label class="form-label small fw-semibold mb-1">Deskripsi Produk</label>
                    <textarea id="prod-deskripsi" class="form-control form-control-sm" rows="3" placeholder="Tulis spesifikasi & keunggulan produk..." required></textarea>
                  </div>
                  <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1 rounded-pill" style="background: var(--brand); border:0;">Simpan Produk</button>
                    <button type="button" id="btn-batal-edit" class="btn btn-sm btn-secondary rounded-pill" style="display:none;">Batal</button>
                  </div>
                </form>
              </div>
            </div>

            <!-- Tabel Daftar Produk -->
            <div class="col-lg-8">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0">📦 Daftar Produk di Database</h6>
                <small class="text-muted">Perubahan langsung sinkron ke AI Chatbot</small>
              </div>
              <div class="table-responsive">
                <table class="table table-hover align-middle small">
                  <thead class="table-light">
                    <tr>
                      <th>Produk</th>
                      <th>Kategori</th>
                      <th>Harga</th>
                      <th>Stok</th>
                      <th class="text-end">Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="admin-table-body">
                    <tr><td colspan="5" class="text-center text-muted py-3">Memuat data...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Widget chatbot -->
  <button id="chat-toggle" aria-label="Buka chat">💬</button>
  <div id="chat-box">
    <div class="chat-head">
      <div class="avatar">🤖</div>
      <div>
        <div class="fw-semibold">Asisten Virtual</div>
        <small><span class="dot"></span>Online</small>
      </div>
    </div>
    <div id="chat-messages">
      <div class="bubble bot">Halo, ada yang bisa saya bantu hari ini? Tanya soal produk, harga, stok, atau status pesanan ya.</div>
    </div>
    <div class="chips" id="chips">
      <button class="chip" data-q="Daftar produk apa saja?">🛍️ Daftar produk</button>
      <button class="chip" data-q="Pesanan saya belum sampai, bisa dicek?">📦 Cek pesanan</button>
      <button class="chip" data-q="Jam layanan kapan?">🕒 Jam layanan</button>
    </div>
    <div class="chat-foot">
      <input id="chat-input" type="text" placeholder="Tulis pesan...">
      <button id="chat-send">Kirim</button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // ----- Status server -----
    fetch('/api/status')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var el = document.getElementById('status-badge');
        el.textContent = '● Server ' + d.status;
        el.className = 'badge rounded-pill text-bg-success fw-normal px-3 py-2 d-none d-sm-inline-block';
      })
      .catch(function () {
        var el = document.getElementById('status-badge');
        el.textContent = '● Server offline';
        el.className = 'badge rounded-pill text-bg-danger fw-normal px-3 py-2 d-none d-sm-inline-block';
      });

    // ----- Filter kategori -----
    document.querySelectorAll('#filter .pill').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('#filter .pill').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var kat = btn.dataset.kategori;
        document.querySelectorAll('#grid .item').forEach(function (item) {
          var tampil = (kat === 'semua' || item.dataset.kategori === kat);
          item.style.display = tampil ? '' : 'none';
          if (tampil) { item.classList.remove('refade'); void item.offsetWidth; item.classList.add('refade'); }
        });
      });
    });

    // ----- Modal Detail Produk saat kartu diklik -----
    var modalProduk = new bootstrap.Modal(document.getElementById('modalDetailProduk'));

    document.querySelectorAll('.produk-card').forEach(function (card) {
      card.addEventListener('click', function () {
        var stok = Number(card.dataset.stok);
        document.getElementById('modal-gambar').src = card.dataset.gambar;
        document.getElementById('modal-gambar').alt = card.dataset.nama;
        document.getElementById('modal-kategori').textContent = card.dataset.kategori;
        document.getElementById('modal-nama').textContent = card.dataset.nama;
        document.getElementById('modal-harga').textContent = card.dataset.harga;
        document.getElementById('modal-deskripsi').textContent = card.dataset.deskripsi;

        var stokEl = document.getElementById('modal-stok');
        if (stok <= 15) {
          stokEl.className = 'stok-tipis mb-3';
          stokEl.textContent = '● Stok terbatas: ' + stok + ' unit';
        } else {
          stokEl.className = 'stok-ok mb-3';
          stokEl.textContent = '● Tersedia: ' + stok + ' unit';
        }

        document.getElementById('modal-btn-tanya').dataset.nama = card.dataset.nama;
        modalProduk.show();
      });
    });

    document.getElementById('modal-btn-tanya').addEventListener('click', function () {
      var namaProduk = this.dataset.nama;
      modalProduk.hide();
      bukaChat();
      kirim('Jelaskan detail dan spesifikasi ' + namaProduk);
    });

    // ----- Panel Admin -----
    var modalAdminLogin = new bootstrap.Modal(document.getElementById('modalAdminLogin'));
    var modalAdminPanel = new bootstrap.Modal(document.getElementById('modalAdminPanel'));
    var adminDaftarProduk = [];

    document.getElementById('btn-open-admin').addEventListener('click', function () {
      if (sessionStorage.getItem('admin_pass')) {
        muatTabelAdmin();
        modalAdminPanel.show();
      } else {
        document.getElementById('login-error').style.display = 'none';
        document.getElementById('input-admin-pass').value = '';
        modalAdminLogin.show();
      }
    });

    document.getElementById('form-admin-login').addEventListener('submit', async function (e) {
      e.preventDefault();
      var pass = document.getElementById('input-admin-pass').value;
      var errEl = document.getElementById('login-error');

      try {
        var res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pass })
        });
        var data = await res.json();
        if (res.ok && data.success) {
          sessionStorage.setItem('admin_pass', pass);
          modalAdminLogin.hide();
          muatTabelAdmin();
          modalAdminPanel.show();
        } else {
          errEl.textContent = data.message || 'Password salah!';
          errEl.style.display = 'block';
        }
      } catch (err) {
        errEl.textContent = 'Gagal terhubung ke server.';
        errEl.style.display = 'block';
      }
    });

    document.getElementById('btn-admin-logout').addEventListener('click', function () {
      sessionStorage.removeItem('admin_pass');
      modalAdminPanel.hide();
      location.reload();
    });

    async function muatTabelAdmin() {
      var tbody = document.getElementById('admin-table-body');
      try {
        var res = await fetch('/api/produk');
        adminDaftarProduk = await res.json();
        if (!adminDaftarProduk.length) {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Belum ada produk.</td></tr>';
          return;
        }
        tbody.innerHTML = adminDaftarProduk.map(function (p) {
          return '<tr>' +
            '<td><strong>' + p.nama + '</strong><br><small class="text-muted text-truncate d-inline-block" style="max-width:200px;">' + (p.deskripsi || '-') + '</small></td>' +
            '<td><span class="badge bg-secondary-subtle text-dark">' + p.kategori + '</span></td>' +
            '<td>Rp ' + Number(p.harga).toLocaleString('id-ID') + '</td>' +
            '<td>' + p.stok + '</td>' +
            '<td class="text-end text-nowrap">' +
              '<button class="btn btn-sm btn-outline-primary me-1" onclick="pilihEditProduk(' + p.id + ')">Edit</button>' +
              '<button class="btn btn-sm btn-outline-danger" onclick="hapusProdukAdmin(' + p.id + ', \'' + p.nama.replace(/'/g, "\\'") + '\')">Hapus</button>' +
            '</td>' +
          '</tr>';
        }).join('');
      } catch (e) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-3">Gagal memuat produk.</td></tr>';
      }
    }

    function resetFormProduk() {
      document.getElementById('form-admin-produk').reset();
      document.getElementById('prod-id').value = '';
      document.getElementById('form-produk-title').textContent = '➕ Tambah Produk Baru';
      document.getElementById('btn-batal-edit').style.display = 'none';
    }

    document.getElementById('btn-batal-edit').addEventListener('click', resetFormProduk);

    window.pilihEditProduk = function (id) {
      var p = adminDaftarProduk.find(function (item) { return item.id === id; });
      if (!p) return;
      document.getElementById('prod-id').value = p.id;
      document.getElementById('prod-nama').value = p.nama;
      document.getElementById('prod-kategori').value = p.kategori;
      document.getElementById('prod-harga').value = p.harga;
      document.getElementById('prod-stok').value = p.stok;
      document.getElementById('prod-gambar').value = p.gambar;
      document.getElementById('prod-deskripsi').value = p.deskripsi || '';
      document.getElementById('form-produk-title').textContent = '✏️ Edit Produk #' + p.id;
      document.getElementById('btn-batal-edit').style.display = 'inline-block';
    };

    document.getElementById('form-admin-produk').addEventListener('submit', async function (e) {
      e.preventDefault();
      var id = document.getElementById('prod-id').value;
      var payload = {
        nama: document.getElementById('prod-nama').value,
        kategori: document.getElementById('prod-kategori').value,
        harga: document.getElementById('prod-harga').value,
        stok: document.getElementById('prod-stok').value,
        gambar: document.getElementById('prod-gambar').value,
        deskripsi: document.getElementById('prod-deskripsi').value
      };

      var url = id ? '/api/produk/' + id : '/api/produk';
      var method = id ? 'PUT' : 'POST';

      var res = await fetch(url, {
        method: method,
        headers: {
          'Content-Type': 'application/json',
          'x-admin-password': sessionStorage.getItem('admin_pass') || ''
        },
        body: JSON.stringify(payload)
      });

      var data = await res.json();
      if (res.ok && data.success) {
        resetFormProduk();
        await muatTabelAdmin();
      } else {
        alert(data.message || 'Gagal menyimpan produk.');
      }
    });

    window.hapusProdukAdmin = async function (id, nama) {
      if (!confirm('Yakin ingin menghapus "' + nama + '"?')) return;
      var res = await fetch('/api/produk/' + id, {
        method: 'DELETE',
        headers: { 'x-admin-password': sessionStorage.getItem('admin_pass') || '' }
      });
      var data = await res.json();
      if (res.ok && data.success) {
        await muatTabelAdmin();
      } else {
        alert(data.message || 'Gagal menghapus produk.');
      }
    };

    // Refresh halaman utama saat modal admin ditutup agar katalog depan ikut terupdate
    document.getElementById('modalAdminPanel').addEventListener('hidden.bs.modal', function () {
      location.reload();
    });

    // ----- Chatbot -----
    var box = document.getElementById('chat-box');
    var msgs = document.getElementById('chat-messages');
    var input = document.getElementById('chat-input');

    function saveChatHistory() {
      if (msgs) localStorage.setItem('chat_history', msgs.innerHTML);
    }

    function loadChatHistory() {
      var savedHistory = localStorage.getItem('chat_history');
      if (msgs && savedHistory) {
        msgs.innerHTML = savedHistory;
        msgs.scrollTop = msgs.scrollHeight;
      }
    }

    document.addEventListener('DOMContentLoaded', loadChatHistory);

    function bukaChat() { box.style.display = 'block'; input.focus(); }

    document.getElementById('chat-toggle').onclick = function () {
      if (box.style.display === 'block') { box.style.display = 'none'; } else { bukaChat(); }
    };
    document.getElementById('hero-chat').onclick = bukaChat;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function tambah(teks, tipe) {
      var div = document.createElement('div');
      div.className = 'bubble ' + tipe;
      div.textContent = teks;
      msgs.appendChild(div);
      msgs.scrollTop = msgs.scrollHeight;
      saveChatHistory();
      return div;
    }

    function tampilkanMengetik() {
      var div = document.createElement('div');
      div.className = 'bubble bot typing';
      div.innerHTML = '<span></span><span></span><span></span>';
      msgs.appendChild(div);
      msgs.scrollTop = msgs.scrollHeight;
      return div;
    }

    function ketikBertahap(el, teks, selesai) {
      var i = 0;
      (function langkah() {
        i = reduce ? teks.length : i + 1;
        el.textContent = teks.slice(0, i);
        msgs.scrollTop = msgs.scrollHeight;
        saveChatHistory();
        if (i < teks.length) { setTimeout(langkah, 18); } else if (selesai) { selesai(); }
      })();
    }

    var sedangMenjawab = false;

    function kirim(teks) {
      if (sedangMenjawab) return;
      var pesan = (teks || input.value).trim();
      if (!pesan) return;
      tambah(pesan, 'user');
      input.value = '';
      sedangMenjawab = true;

      var indikator = tampilkanMengetik();
      var mulai = Date.now();

      fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: pesan })
      })
        .then(function (r) { return r.json(); })
        .then(function (d) { 
          if (d.data && d.data.reply) return d.data.reply;
          return d.balasan || d.message || 'Respons tidak valid.'; 
        })
        .catch(function () { return 'Maaf, server sedang bermasalah.'; })
        .then(function (balasan) {
          var sisa = Math.max(0, 900 - (Date.now() - mulai));
          setTimeout(function () {
            indikator.remove();
            var el = tambah('', 'bot');
            ketikBertahap(el, balasan, function () { sedangMenjawab = false; });
          }, sisa);
        });
    }

    document.getElementById('chat-send').onclick = function () { kirim(); };
    input.addEventListener('keydown', function (e) { if (e.key === 'Enter') kirim(); });

    document.querySelectorAll('.tanya').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        bukaChat();
        kirim('Harga ' + btn.dataset.nama + ' berapa?');
      });
    });

    document.querySelectorAll('#chips .chip').forEach(function (btn) {
      btn.addEventListener('click', function () { kirim(btn.dataset.q); });
    });

    (function () {
      var judul = document.getElementById('hero-title');
      var teks = judul.textContent.trim();
      if (reduce) return;
      judul.innerHTML = '<span class="on"></span><span class="off"></span>';
      var on = judul.querySelector('.on'), off = judul.querySelector('.off');
      off.textContent = teks;
      judul.classList.add('caret');
      var n = 0;
      (function langkah() {
        n++;
        on.textContent = teks.slice(0, n);
        off.textContent = teks.slice(n);
        if (n < teks.length) { setTimeout(langkah, 45); }
        else { setTimeout(function () { judul.classList.remove('caret'); }, 2000); }
      })();
    })();

    document.querySelectorAll('.count').forEach(function (el) {
      var target = Number(el.dataset.to), n = 0;
      if (reduce || !target) return;
      el.textContent = 0;
      var iv = setInterval(function () {
        n++; el.textContent = n;
        if (n >= target) clearInterval(iv);
      }, 200);
    });

    var kartu = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('show'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      kartu.forEach(function (el) { io.observe(el); });
    } else {
      kartu.forEach(function (el) { el.classList.add('show'); });
    }
  </script>
</body>
</html>